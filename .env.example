# Copy to .env and fill in. The control plane does NOT read .env itself: export it first with
#   set -a; . ./.env; set +a
# (the infra/*/apply.sh scripts source it the same way). Quote values that contain spaces.
# Defaults below are for the local quickstart in README.md. Every variable is defined in
# apps/control-plane/src/config.ts; unset optional ones are left commented out.

# ---- required
DATABASE_URL=postgres://ai:ai@localhost:5432/ai_employee
DBOS_SYSTEM_DATABASE_URL=postgres://ai:ai@localhost:5432/ai_employee_dbos

# ---- server
PORT=3000
# URL the runners use to reach this control plane (event sink, agent tools). For local-process
# runners that is localhost; for kind, use http://host.docker.internal:3000.
PUBLIC_BASE_URL=http://localhost:3000
# Which sandbox runtime runs tasks: local | k8s | warm | cloudrun   (default k8s)
SANDBOX_RUNTIME=local
# Directory of employee YAML files (default: roles, relative to the working directory).
# The container images set ROLES_DIR=/app/apps/control-plane/roles.
# ROLES_DIR=roles
# Employee that receives Slack and ClickUp traffic (default dev).
# DEFAULT_EMPLOYEE_ID=dev
# LOG_LEVEL=info

# ---- model access: set ONE of these (a role's `credentials` list picks which one a run gets)
ANTHROPIC_API_KEY=
# or run `claude setup-token` and paste here (Pro/Max/Team/Enterprise, 1-year token)
CLAUDE_CODE_OAUTH_TOKEN=
# More than one subscription: CLAUDE_CODE_OAUTH_TOKEN_<NAME>=... per account (see README, "Claude accounts, usage and limits").

# ---- sandbox runtime settings
# k8s: image the Job pods run (a role's `image` overrides it).
RUNNER_IMAGE=ai-employee-runner:dev
# local: command that starts the runner (run from apps/control-plane). The runner defaults to
# /workspace, which often cannot be created, so point WORKSPACE_DIR somewhere writable via `env`.
LOCAL_RUNNER_CMD="env WORKSPACE_DIR=$HOME/ai-employee-workspace node ../runner/dist/index.js"
# warm: URL of the always-on runner and the shared secret on both sides.
# WARM_RUNNER_URL=http://runner:8080
# RUNNER_TOKEN=
# cloudrun (also the isolated tier on a warm deployment): needs GCP_PROJECT.
# GCP_PROJECT=my-gcp-project
# GCP_REGION=us-central1
# CLOUDRUN_JOB_PREFIX=ai-employee

# ---- Slack (Events API -> POST /slack/events)
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# ---- ClickUp (webhooks -> /clickup/webhook, Chat Automation -> /clickup/chat)
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=
CLICKUP_WEBHOOK_SECRET=
CLICKUP_CHAT_SECRET=
# ClickUp user id of the bot account (assignee trigger, loop guard).
CLICKUP_BOT_USER_ID=
# Word in a comment that summons the employee. Empty = "!<DEFAULT_EMPLOYEE_ID>", e.g. !dev
CLICKUP_TRIGGER_WORD=
# CLICKUP_CHAT_HISTORY=20
# Chat channel id for failure alerts, the daily digest and quiet monitor/manager output. Unset = off.
ALERT_CHANNEL_ID=

# ---- Telegram (bot webhook -> POST /webhooks/telegram). Empty token = channel off.
TELEGRAM_BOT_TOKEN=
# Any random string; setWebhook sends it and Telegram echoes it in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric chat ids allowed to talk to the employee; everyone else is ignored.
TELEGRAM_ALLOWED_CHAT_IDS=
# Employee that owns Telegram traffic. Empty = DEFAULT_EMPLOYEE_ID.
# TELEGRAM_EMPLOYEE_ID=

# ---- credentials injected into runners per role grant (see docs/configuration.md#credentials)
GH_TOKEN=
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
# Azure token broker (infra/azbroker); alternative to a service principal.
# AZURE_BROKER_URL=
# AZURE_BROKER_SECRET=

# ---- manager, schedules, digest
# Role woken when backlog work finishes. Empty disables the manager.
# MANAGER_ROLE=manager
# MANAGER_DEBOUNCE_SEC=300
# MANAGER_HEARTBEAT_MIN=60
# Set false on a second control plane that shares the database, so only one fires schedules/monitors.
# TICK_ENABLED=true
# DIGEST_CRON="0 8 * * *"
# DIGEST_TZ=America/Los_Angeles

# ---- per-employee logins (employee file `credentials:`): where `secret:` references are read
# SECRET_STORE=env                 # env: SECRET_<NAME> (dashes as underscores), e.g. SECRET_CLICKUP_API_TOKEN. gcp: Secret Manager in GCP_PROJECT

# ---- read by infra/*/apply.sh only (not by the control plane)
# GCP_PROJECT=my-gcp-project
# GCP_ACCOUNT=you@example.com
# DB_PASSWORD=                     # gcp-cloudrun: password for the Cloud SQL user
# RUNNER_TOKEN                     # gcp-vm: generated and appended here on first run
# AZBROKER_IMAGE=                  # gcp-vm: image URL of infra/azbroker to enable the sidecar
# PUBLIC_BASE_URL_CLOUD=           # gcp-cloudrun: the service_url, after first apply
# Bearer token for /usage and /settings/claude (empty = no in-app check; restrict them at the network layer).
ADMIN_TOKEN=
